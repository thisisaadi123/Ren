# Copy this file to .env and fill it in. .env is gitignored; never commit it.
# On Vercel, set the same variables (except PORT) under Project Settings →
# Environment Variables. SESSION_SECRET is required there.

PORT=3000

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# A test account, created (or reset to these values) every time the server starts.
SEED_EMAIL=
SEED_PASSWORD=
SEED_NAME=

# Optional: the judge server for DSA Run and Submit (judge/README.md). Without
# it, DSA code runs only on this machine, and not at all on Vercel.
JUDGE_URL=
JUDGE_SECRET=
