# Copy this file to .env and fill it in. .env is gitignored; never commit it.

PORT=3000

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# A test account, created (or reset to these values) every time the server starts.
SEED_EMAIL=
SEED_PASSWORD=
SEED_NAME=
