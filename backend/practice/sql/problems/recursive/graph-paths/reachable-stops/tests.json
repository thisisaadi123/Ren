{"problem": "reachable-stops", "tests": [
  {"id":"ex1","example":true,"data":{"routes":[["A","B"],["B","C"],["C","A"],["D","E"],["C","D"]]},"explanation":"From A you reach B, then C, then D (from C), then E. The loop C → A doesn't add anything new.","expected":{"columns":["stop"],"rows":[["B"],["C"],["D"],["E"]]}},
