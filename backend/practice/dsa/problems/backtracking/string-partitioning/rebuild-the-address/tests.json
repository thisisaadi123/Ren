{
  "problem": "rebuild-the-address",
  "version": 1,
  "seed": 2571753,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"digits":"25525511135"},
      "expected": ["255.255.11.135","255.255.111.35"],
      "explanation": "Only two ways keep every part within 0–255."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"digits":"0000"},
      "expected": ["0.0.0.0"],
      "explanation": "Each part is a single 0."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"digits":"101023"},
      "expected": ["1.0.10.23","1.0.102.3","10.1.0.23","10.10.2.3","101.0.2.3"],
      "explanation": "Parts like 01 aren't allowed."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"digits":"1111"},
      "expected": ["1.1.1.1"]
    },
