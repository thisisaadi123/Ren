{
  "problem": "square-sum-line-ups",
  "version": 1,
  "seed": 50287678,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"nums":[1,8,17]},
      "expected": 2,
      "explanation": "1 + 8 = 9 and 8 + 17 = 25, so 1, 8, 17 works, and so does its reverse 17, 8, 1."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"nums":[3,3,1]},
      "expected": 1,
      "explanation": "3 + 3 = 6 isn't a square, so the 1 must sit between the 3s: 3, 1, 3."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"nums":[5,6]},
      "expected": 0,
      "explanation": "5 + 6 = 11 is not a perfect square."
    },
