      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"preorder":[1,2,3],"inorder":[3,2,1]},
      "expected": [1,2,null,3],
      "explanation": "Each node is left of its parent in the in-order walk, so it's a left chain."
    },
