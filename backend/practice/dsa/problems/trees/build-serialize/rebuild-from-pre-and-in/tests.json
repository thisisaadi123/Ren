  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"preorder":[3,9,20,15,7],"inorder":[9,3,15,20,7]},
      "expected": [3,9,20,null,null,15,7],
      "explanation": "3 is the root; 9 is left of it in the in-order walk, and 15, 20, 7 are right of it."
    },
    {
      "id": "ex2",
