      "visible": false,
      "kind": "edge",
      "input": {"preorder":[1,2,3,4],"postorder":[4,3,2,1]},
      "expected": [1,2,null,3,null,4]
    },
    {
      "id": "edge-one-then-two",
      "visible": false,
      "kind": "edge",
      "input": {"preorder":[3,1,2,4],"postorder":[2,4,1,3]},
      "expected": [3,1,null,2,4]
    },
    {
      "id": "edge-unbalanced",
      "visible": false,
      "kind": "edge",
      "input": {"preorder":[1,2,3,4,5],"postorder":[3,4,2,5,1]},
      "expected": [1,2,5,3,4]
    },
    {
      "id": "edge-five",
      "visible": false,
      "kind": "edge",
      "input": {"preorder":[5,4,3,2,1],"postorder":[2,1,3,4,5]},
      "expected": [5,4,null,3,null,2,1]
    },
