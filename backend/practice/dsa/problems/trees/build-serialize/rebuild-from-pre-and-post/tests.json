{
  "problem": "rebuild-from-pre-and-post",
  "version": 1,
  "seed": 93758160,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"preorder":[1,2,4,5,3,6,7],"postorder":[4,5,2,6,7,3,1]},
      "expected": [1,2,3,4,5,6,7],
      "explanation": "1 is the root; 2's subtree ends where 2 appears in post-order."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"preorder":[1],"postorder":[1]},
      "expected": [1],
      "explanation": "One node."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"preorder":[1,2],"postorder":[2,1]},
      "expected": [1,2],
      "explanation": "2 could be a left or a right child; [1, null, 2] is accepted too."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"preorder":[2,1,3],"postorder":[1,3,2]},
      "expected": [2,1,3]
    },
    {
