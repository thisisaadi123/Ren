{
  "problem": "rebuild-from-in-and-post",
  "version": 1,
  "seed": 14402194,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"inorder":[9,3,15,20,7],"postorder":[9,15,7,20,3]},
      "expected": [3,9,20,null,null,15,7],
      "explanation": "3 comes last in the post-order walk, so it's the root."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"inorder":[-1],"postorder":[-1]},
      "expected": [-1],
      "explanation": "One node."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"inorder":[1,2,3],"postorder":[3,2,1]},
      "expected": [1,null,2,null,3],
      "explanation": "Each node is right of its parent in the in-order walk, so it's a right chain."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"inorder":[2,1],"postorder":[2,1]},
      "expected": [1,2]
    },
    {
      "id": "edge-two-right",
      "visible": false,
      "kind": "edge",
      "input": {"inorder":[1,2],"postorder":[2,1]},
      "expected": [1,null,2]
    },
    {
      "id": "edge-left-chain",
      "visible": false,
      "kind": "edge",
      "input": {"inorder":[3,2,1],"postorder":[3,2,1]},
      "expected": [1,2,null,3]
    },
    {
      "id": "edge-full",
      "visible": false,
      "kind": "edge",
      "input": {"inorder":[1,2,3,4,5,6,7],"postorder":[1,3,2,5,7,6,4]},
      "expected": [4,2,6,1,3,5,7]
    },
    {
      "id": "edge-zigzag",
      "visible": false,
      "kind": "edge",
      "input": {"inorder":[2,4,3,1],"postorder":[4,3,2,1]},
      "expected": [1,2,null,null,3,4]
    },
