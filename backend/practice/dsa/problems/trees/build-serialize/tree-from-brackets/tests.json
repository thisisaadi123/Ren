{
  "problem": "tree-from-brackets",
  "version": 1,
  "seed": 78781940,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"s":"4(2(3)(1))(6(5))"},
      "expected": [4,2,6,3,1,5],
      "explanation": "4 has children 2 and 6; 2 has 3 and 1; 6 has a left child 5."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"s":"1()(2)"},
      "expected": [1,null,2],
      "explanation": "The empty () means 2 is the RIGHT child."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"s":"-15"},
      "expected": [-15],
      "explanation": "A single node, with a negative value."
