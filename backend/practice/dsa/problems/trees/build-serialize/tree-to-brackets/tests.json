{
  "problem": "tree-to-brackets",
  "version": 1,
  "seed": 99434634,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,2,3,4]},
      "expected": "1(2(4))(3)",
      "explanation": "2 has no right child, so nothing is written after (4)."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,2,3,null,4]},
      "expected": "1(2()(4))(3)",
      "explanation": "2 has a right child but no left one, so it keeps the empty ()."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[-7]},
      "expected": "-7",
      "explanation": "A single node is just its value."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[5,null,6]},
      "expected": "5()(6)"
    },
    {
      "id": "edge-left-only",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2]},
      "expected": "1(2)"
    },
    {
      "id": "edge-right-chain",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,null,2,null,3]},
      "expected": "1()(2()(3))"
    },
    {
      "id": "edge-negatives",
      "visible": false,
      "kind": "edge",
      "input": {"root":[-1,-2,-3]},
      "expected": "-1(-2)(-3)"
    },
    {
      "id": "edge-full",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2,3,4,5,6,7]},
      "expected": "1(2(4)(5))(3(6)(7))"
    },
