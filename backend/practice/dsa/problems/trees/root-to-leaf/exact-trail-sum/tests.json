{
  "problem": "exact-trail-sum",
  "version": 1,
  "seed": 44073673,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[5,4,8,11,null,13,4,7,2,null,null,null,1],"target":22},
      "expected": true,
      "explanation": "5 → 4 → 11 → 2 adds up to 22."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,2,3],"target":1},
      "expected": false,
      "explanation": "The two trails total 3 and 4; stopping at the root (1) doesn't count."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[],"target":0},
      "expected": false,
      "explanation": "An empty map has no trail at all."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[-2,null,-3],"target":-5},
      "expected": true
    },
    {
      "id": "edge-one-hit",
      "visible": false,
      "kind": "edge",
      "input": {"root":[7],"target":7},
      "expected": true
    },
    {
      "id": "edge-one-miss",
      "visible": false,
      "kind": "edge",
      "input": {"root":[7],"target":0},
      "expected": false
    },
    {
      "id": "edge-one-child-root",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2],"target":1},
      "expected": false
    },
    {
      "id": "edge-negatives",
      "visible": false,
      "kind": "edge",
      "input": {"root":[-1,-2,3,null,null,-4,5],"target":-2},
      "expected": true
    },
    {
      "id": "edge-zeros",
      "visible": false,
      "kind": "edge",
      "input": {"root":[0,0,0,0],"target":0},
      "expected": true
    },
    {
      "id": "edge-last-leaf",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2,3,4,5,6,7],"target":11},
      "expected": true
    },
    {
      "id": "edge-dips-then-climbs",
      "visible": false,
      "kind": "edge",
      "input": {"root":[10,-20,null,15],"target":5},
