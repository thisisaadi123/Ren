    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[5,4,8,11,null,13,4,7,2,null,null,5,1],"target":22},
      "expected": [[5,4,11,2],[5,8,4,5]],
      "explanation": "Two routes total 22; the one ending at leaf 2 is further left."
