      "input": {"root":[25,1,3,1,3,0,2]},
      "expected": "adz",
      "explanation": "Leaf 0 (a) under 3 (d) gives adz, which beats every word starting with b."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[25,1,2,25,null,0]},
      "expected": "acz",
      "explanation": "Heading for the smaller child b leads to zbz, but the leaf a under c gives acz, which is smaller."
    },
