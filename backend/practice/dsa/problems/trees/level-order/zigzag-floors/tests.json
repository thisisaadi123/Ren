{
  "problem": "zigzag-floors",
  "version": 1,
  "seed": 48470011,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[3,9,20,null,null,15,7]},
      "expected": [[3],[20,9],[15,7]],
      "explanation": "Floor 1 is cleaned right to left, floor 2 left to right again."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,2,3,4,5,6,7,8,9]},
      "expected": [[1],[3,2],[4,5,6,7],[9,8]],
      "explanation": "The fourth floor (8, 9) is odd-numbered, so it is reversed."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[]},
      "expected": [],
      "explanation": "Nothing to clean."
    },
