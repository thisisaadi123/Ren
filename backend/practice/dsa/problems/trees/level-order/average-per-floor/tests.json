{
  "problem": "average-per-floor",
  "version": 1,
  "seed": 58380824,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[3,9,20,null,null,15,7]},
      "expected": [3,14.5,11],
      "explanation": "Floor 1 is (9 + 20) / 2 = 14.5 and floor 2 is (15 + 7) / 2 = 11."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,2,3,4]},
      "expected": [1,2.5,4],
      "explanation": "Floor 2 has only one person, 4."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[-5]},
      "expected": [-5]
    },
    {
      "id": "sample2",
      "visible": true,
      "kind": "sample",
      "input": {"root":[7,1000000000,999999999,1000000000,1000000000,1000000000]},
      "expected": [7,999999999.5,1000000000]
    },
    {
      "id": "edge-one",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1000000000]},
      "expected": [1000000000]
    },
    {
      "id": "edge-big-floor",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,1000000000,1000000000,1000000000,1000000000,1000000000,1000000000]},
      "expected": [1,1000000000,1000000000]
    },
    {
      "id": "edge-negatives",
      "visible": false,
      "kind": "edge",
      "input": {"root":[-1000000000,-1000000000,-999999999,-1000000000]},
      "expected": [-1000000000,-999999999.5,-1000000000]
    },
    {
      "id": "edge-thirds",
      "visible": false,
      "kind": "edge",
      "input": {"root":[0,1,1,1,null,null,2]},
      "expected": [0,1,1.5]
    },
    {
      "id": "edge-left-chain",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2,null,3,null,4]},
      "expected": [1,2,3,4]
    },
    {
      "id": "edge-right-chain",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,null,2,null,3]},
      "expected": [1,2,3]
    },
    {
      "id": "edge-zero-sum-floor",
      "visible": false,
      "kind": "edge",
      "input": {"root":[7,-3,3,5,null,null,-5]},
      "expected": [7,0,0]
