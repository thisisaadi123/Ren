{
  "problem": "cousin-sums",
  "version": 1,
  "seed": 37570765,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[5,4,9,1,10,null,7]},
      "expected": [0,0,0,7,7,null,11],
      "explanation": "On floor 2, 1 and 10 share a parent, so their only cousin is 7 (sum 7); 7's cousins are 1 and 10 (sum 11)."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[3,1,2]},
      "expected": [0,0,0],
      "explanation": "The root's children are siblings, not cousins."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[1,2,3,4,5,6,7]},
      "expected": [0,0,0,13,13,9,9]
    },
    {
      "id": "edge-one",
      "visible": false,
      "kind": "edge",
      "input": {"root":[10000]},
      "expected": [0]
    },
    {
      "id": "edge-left-chain",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2,null,3,null,4]},
      "expected": [0,0,null,0,null,0]
    },
    {
      "id": "edge-single-child-cousins",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2,3,4,null,null,5]},
      "expected": [0,0,0,5,null,null,4]
    },
    {
      "id": "edge-only-child-row",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2,3,null,4,null,5,6,null,7]},
      "expected": [0,0,0,null,5,null,4,7,null,6]
    },
    {
      "id": "edge-max-values",
      "visible": false,
      "kind": "edge",
      "input": {"root":[10000,10000,10000,10000,10000,10000,10000]},
      "expected": [0,0,0,20000,20000,20000,20000]
    },
    {
      "id": "edge-uneven",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2,3,4,5,6,null,7,null,null,8,9,10]},
      "expected": [0,0,0,6,6,9,null,27,null,null,26,15,15]
    },
