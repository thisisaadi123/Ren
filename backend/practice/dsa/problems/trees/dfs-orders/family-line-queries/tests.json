{
  "problem": "family-line-queries",
  "version": 1,
  "seed": 70651306,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[5,3,8,1,4,null,9],"queries":[[5,4],[3,9],[8,9],[4,4]]},
      "expected": [true,false,true,false],
      "explanation": "5 is the root, so it is above 4. 3 and 9 are in different branches. 8 is 9's parent. Nobody is their own ancestor."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[2,null,7,6],"queries":[[6,2],[2,6]]},
      "expected": [false,true],
      "explanation": "The chain is 2 → 7 → 6, so 2 is above 6 but not the other way round."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[1],"queries":[[1,1]]},
      "expected": [false]
    },
