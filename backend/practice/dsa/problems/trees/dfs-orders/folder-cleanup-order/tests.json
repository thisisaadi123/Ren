{
  "problem": "folder-cleanup-order",
  "version": 1,
  "seed": 77986474,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,null,2,3]},
      "expected": [3,2,1],
      "explanation": "3 is inside 2, and 2 is inside 1, so they go innermost first."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[8,3,10,1,6]},
      "expected": [1,6,3,10,8],
      "explanation": "Folder 3 goes after 1 and 6; the root goes last."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[]},
      "expected": [],
      "explanation": "Nothing to delete."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[2,7,5,null,6,null,9]},
      "expected": [6,7,9,5,2]
    },
