{
  "problem": "shelf-order-readout",
  "version": 1,
  "seed": 19973472,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,null,2,3]},
      "expected": [1,3,2],
      "explanation": "1 has no left branch, so it comes first; 2's left branch (3) is read before 2."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[4,2,6,1,3,5,7]},
      "expected": [1,2,3,4,5,6,7],
      "explanation": "Each node sits between its left and right branches."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[]},
      "expected": [],
      "explanation": "An empty catalogue has nothing to read."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[5,3,null,null,4,8]},
      "expected": [3,8,4,5]
    },
    {
      "id": "edge-one",
      "visible": false,
      "kind": "edge",
      "input": {"root":[7]},
      "expected": [7]
    },
    {
      "id": "edge-left-chain",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2,null,3,null,4]},
      "expected": [4,3,2,1]
    },
    {
      "id": "edge-right-chain",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,null,2,null,3,null,4]},
      "expected": [1,2,3,4]
    },
    {
      "id": "edge-zigzag",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2,null,null,3,4]},
      "expected": [2,4,3,1]
    },
    {
      "id": "edge-full",
      "visible": false,
      "kind": "edge",
      "input": {"root":[4,2,6,1,3,5,7]},
      "expected": [1,2,3,4,5,6,7]
    },
    {
      "id": "edge-repeats-negatives",
      "visible": false,
      "kind": "edge",
      "input": {"root":[0,-5,-5,0,null,null,-1000,1000]},
      "expected": [1000,0,-5,0,-5,-1000]
    },
    {
      "id": "edge-root-only-right",
      "visible": false,
      "kind": "edge",
      "input": {"root":[-3,null,8,9,10]},
      "expected": [-3,9,8,10]
    },
    {
