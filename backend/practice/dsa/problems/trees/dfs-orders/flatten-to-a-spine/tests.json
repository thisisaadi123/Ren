{
  "problem": "flatten-to-a-spine",
  "version": 1,
  "seed": 75316144,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,2,5,3,4,null,6]},
      "expected": [1,null,2,null,3,null,4,null,5,null,6],
      "explanation": "Pre-order is 1, 2, 3, 4, 5, 6, and each node's only child is on the right."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[7,4]},
      "expected": [7,null,4],
      "explanation": "The single left child moves to the right."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[]},
      "expected": [],
      "explanation": "An empty tree stays empty."
    },
