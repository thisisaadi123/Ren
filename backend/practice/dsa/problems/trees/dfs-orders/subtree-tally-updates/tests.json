{
  "problem": "subtree-tally-updates",
  "version": 1,
  "seed": 31374068,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,2,3,4,5],"ops":[[1,4,10],[1,3,7],[2,2],[2,1],[1,2,1],[2,2]]},
      "expected": [10,17,11],
      "explanation": "Office 2's branch is {2, 4, 5}: first 10, then 11 after 2 receives 1. The root's branch holds everything: 17."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[6,null,9],"ops":[[2,6],[1,9,1000000000],[1,9,1000000000],[2,6],[2,9]]},
      "expected": [0,2000000000,2000000000],
      "explanation": "Nothing has arrived at first; the two gifts to 9 count for 9 and for 6 above it, and exceed 32-bit range."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[5],"ops":[[1,5,3],[2,5]]},
      "expected": [3]
    },
    {
