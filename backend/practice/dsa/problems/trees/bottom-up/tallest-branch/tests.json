{
  "problem": "tallest-branch",
  "version": 1,
  "seed": 202,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[3,9,20,null,null,15,7]},
      "expected": 3,
      "explanation": "The longest line is 3 → 20 → 15 (or 3 → 20 → 7): three generations."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,null,2]},
      "expected": 2,
      "explanation": "The root and its single child make two generations."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[]},
      "expected": 0,
      "explanation": "An empty tree has no generations."
    },
    {
      "id": "edge-one",
      "kind": "edge",
      "visible": false,
      "input": {"root":[5]},
      "expected": 1
    },
    {
      "id": "edge-left-chain",
      "kind": "edge",
      "visible": false,
      "input": {"root":[1,2,null,3,null,4]},
      "expected": 4
    },
    {
      "id": "edge-right-chain",
      "kind": "edge",
      "visible": false,
      "input": {"root":[1,null,2,null,3,null,4]},
      "expected": 4
    },
    {
      "id": "edge-full",
      "kind": "edge",
      "visible": false,
      "input": {"root":[1,2,3,4,5,6,7]},
      "expected": 3
    },
    {
      "id": "edge-zigzag",
      "kind": "edge",
      "visible": false,
      "input": {"root":[1,2,null,null,3,4]},
      "expected": 4
    },
    {
      "id": "random",
      "kind": "random",
      "visible": false,
      "generate": {"args":"--n 30","count":10}
    },
    {
      "id": "random-big",
