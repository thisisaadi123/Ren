{
  "problem": "shared-ancestor-queries",
  "version": 1,
  "seed": 63368397,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"parent":[-1,0,0,1,1,2,2],"queries":[[3,4],[3,5],[1,4]]},
      "expected": [1,0,1],
      "explanation": "3 and 4 share parent 1; 3 and 5 only meet at the root; 1 is 4's own ancestor."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"parent":[-1],"queries":[[0,0]]},
      "expected": [0],
      "explanation": "A person is their own ancestor."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"parent":[-1,0,1,2,3],"queries":[[4,2],[1,4]]},
      "expected": [2,1],
      "explanation": "On a chain, the higher of the two is the answer."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"parent":[-1,2,0,2,1],"queries":[[4,3],[4,1],[3,0]]},
      "expected": [2,1,0]
    },
