  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"parent":[-1,0,0,1,1,2,2],"queries":[[3,1],[5,2],[6,3]]},
      "expected": [1,0,-1],
      "explanation": "3's parent is 1; 5's grandparent is 0; 6 has only two ancestors."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"parent":[-1],"queries":[[0,1]]},
      "expected": [-1],
      "explanation": "The root has no ancestors."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"parent":[-1,0,1,2,3],"queries":[[4,4],[4,5],[2,2]]},
      "expected": [0,-1,0],
      "explanation": "A chain: 4's 4th ancestor is the root, and there's no 5th."
    },
