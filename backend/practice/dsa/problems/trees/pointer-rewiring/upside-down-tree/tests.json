{
  "problem": "upside-down-tree",
  "version": 1,
  "seed": 53650934,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,2,3,4,5]},
      "expected": [4,5,2,null,null,3,1],
      "explanation": "4 becomes the root, with 5 on its left and 2 on its right; 2 gets 3 on its left and 1 on its right."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
