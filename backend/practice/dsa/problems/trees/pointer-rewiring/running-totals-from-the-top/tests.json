{
  "problem": "running-totals-from-the-top",
  "version": 1,
  "seed": 62700394,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[4,1,6,0,2,5,7,null,null,null,3,null,null,null,8]},
      "expected": [30,36,21,36,35,26,15,null,null,null,33,null,null,null,8],
      "explanation": "8 has nothing larger and stays 8; 7 becomes 15; 6 becomes 21; and so on down to 0, which becomes 36."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[0,null,1]},
      "expected": [1,null,1],
      "explanation": "1 stays 1; 0 becomes 0 + 1."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[5]},
      "expected": [5],
      "explanation": "A single node keeps its value."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[3,2,4,1]},
      "expected": [7,9,4,10]
    },
    {
      "id": "edge-left-chain",
      "visible": false,
      "kind": "edge",
      "input": {"root":[3,2,null,1]},
      "expected": [3,5,null,6]
    },
    {
      "id": "edge-zero-root",
      "visible": false,
      "kind": "edge",
      "input": {"root":[0]},
      "expected": [0]
    },
    {
      "id": "edge-balanced",
      "visible": false,
      "kind": "edge",
      "input": {"root":[20,10,30,5,15,25,35]},
      "expected": [110,135,65,140,125,90,35]
    },
    {
      "id": "edge-zigzag",
      "visible": false,
      "kind": "edge",
      "input": {"root":[10,2,null,null,8,4]},
      "expected": [10,24,null,null,18,22]
    },
    {
