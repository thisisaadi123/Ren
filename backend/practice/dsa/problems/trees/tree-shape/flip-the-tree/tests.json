{
  "problem": "flip-the-tree",
  "version": 1,
  "seed": 57972781,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[4,2,7,1,3,6,9]},
      "expected": [4,7,2,9,6,3,1],
      "explanation": "Every level reads backwards after the flip."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[2,1,3]},
      "expected": [2,3,1],
      "explanation": "The two children trade places."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[]},
      "expected": [],
      "explanation": "An empty tree stays empty."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[1,2,null,3]},
      "expected": [1,null,2,null,3]
    },
    {
      "id": "edge-single",
      "visible": false,
      "kind": "edge",
      "input": {"root":[5]},
      "expected": [5]
    },
    {
      "id": "edge-right-chain",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,null,2,null,3]},
      "expected": [1,2,null,3]
    },
    {
      "id": "edge-uneven",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2,3,null,4,5]},
      "expected": [1,3,2,null,5,4]
    },
    {
      "id": "edge-deep",
      "visible": false,
      "kind": "edge",
      "input": {"root":[1,2,3,4,5,6,7,8,9]},
      "expected": [1,3,2,7,6,5,4,null,null,null,null,null,null,9,8]
    },
