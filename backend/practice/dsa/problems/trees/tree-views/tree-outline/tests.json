  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,null,2,3,4]},
      "expected": [1,3,4,2],
      "explanation": "No left edge; the leaves are 3 and 4; the right edge (bottom to top) is 2."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,2,3,4,5,6,null,null,null,7,8,9,10]},
      "expected": [1,2,4,7,8,9,10,6,3],
      "explanation": "Left edge 2; leaves 4, 7, 8, 9, 10; right edge 6 then 3 going up."
    },
    {
