{
  "problem": "view-from-above",
  "version": 1,
  "seed": 79081543,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[1,2,3,null,4,null,null,null,5,null,6]},
      "expected": [2,1,3,6],
      "explanation": "4 sits in column 0 under the root, and 5 in column 1 under 3, so neither is seen. 6 is alone in column 2."
    },
    {
      "id": "ex2",
