    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"prices":[1,2,3,4,5],"k":4,"x":3},
      "expected": [1,2,3,4],
      "explanation": "1 and 5 are both 2 away from 3; the smaller price, 1, wins."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"prices":[1,1,2,3,4,5],"k":4,"x":-1},
      "expected": [1,1,2,3],
      "explanation": "Everything is to the right of -1, so take the four smallest."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
