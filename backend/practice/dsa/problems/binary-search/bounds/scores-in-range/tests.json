  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"scores":[70,85,90,60,85],"queries":[[80,90],[0,59],[85,85]]},
      "expected": [3,0,2],
      "explanation": "85, 90 and 85 are in [80, 90]; nobody scored below 60; two people scored exactly 85."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"scores":[5],"queries":[[5,5],[-10,4]]},
      "expected": [1,0],
      "explanation": "The single score 5 is in the first range only."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"scores":[1,2,3],"queries":[[-1000000000,1000000000]]},
      "expected": [3],
      "explanation": "The range covers everything."
    },
