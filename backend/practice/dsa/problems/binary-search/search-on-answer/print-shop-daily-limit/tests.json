{
  "problem": "print-shop-daily-limit",
  "version": 1,
  "seed": 20260929,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"pages":[4,2,7,3,5],"days":3},
      "expected": 8,
      "explanation": "With a limit of 8 the days are [4, 2], [7] and [3, 5]. With 7, the last two jobs need a day each, so it takes 4 days."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"pages":[5,5,5,5],"days":2},
      "expected": 10,
      "explanation": "Two jobs fit each day at a limit of 10. Any lower and each day holds only one job."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"pages":[3,1,4,1,5,9,2],"days":7},
      "expected": 9,
      "explanation": "There are as many days as jobs, so each job can have its own day. The limit only has to fit the biggest job."
    },
