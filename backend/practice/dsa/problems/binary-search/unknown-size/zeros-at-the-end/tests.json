{
  "problem": "zeros-at-the-end",
  "version": 1,
  "seed": 66204221,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"zeros":1},
      "expected": 5,
      "explanation": "5! = 120 ends with one zero; 4! = 24 has none."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"zeros":6},
      "expected": 25,
      "explanation": "24! ends with 4 zeros, and 25! jumps to 6, because 25 contributes two factors of 5."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"zeros":5},
      "expected": 25,
      "explanation": "No factorial ends with exactly 5 zeros, so the first with at least 5 is 25!."
    },
    {
      "id": "edge-zero",
      "visible": false,
      "kind": "edge",
      "input": {"zeros":0},
      "expected": 0
    },
    {
      "id": "edge-max",
      "visible": false,
      "kind": "edge",
      "input": {"zeros":2000000000000000},
      "no_brute": true,
      "expected": 8000000000000025
    },
    {
      "id": "edge-big",
      "visible": false,
      "kind": "edge",
      "input": {"zeros":1000000000000},
      "no_brute": true,
      "expected": 4000000000010
    },
