{
  "problem": "influence-score",
  "version": 1,
  "seed": 87209669,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"citations":[3,0,6,1,5]},
      "expected": 3,
      "explanation": "Three papers (3, 6 and 5) have at least 3 citations; there aren't four with at least 4."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"citations":[1,3,1]},
      "expected": 1,
      "explanation": "Only one paper has 2 or more citations."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"citations":[0]},
      "expected": 0,
      "explanation": "No paper has been cited."
    },
    {
      "id": "edge-all-high",
      "visible": false,
      "kind": "edge",
      "input": {"citations":[100,100,100]},
      "expected": 3
    },
    {
      "id": "edge-all-zero",
      "visible": false,
      "kind": "edge",
      "input": {"citations":[0,0,0,0]},
      "expected": 0
    },
    {
      "id": "edge-exact",
      "visible": false,
      "kind": "edge",
      "input": {"citations":[4,4,4,4]},
      "expected": 4
    },
    {
      "id": "edge-single-cited",
      "visible": false,
      "kind": "edge",
      "input": {"citations":[1]},
      "expected": 1
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 20","count":12}
    },
    {
      "id": "mid",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 3000","count":12}
    },
    {
      "id": "huge",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 3000 --hi 1000000000","count":8}
    },
    {
      "id": "low",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 3000 --hi 5","count":6}
    },
    {
      "id": "max",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 100000","count":2}
    },
    {
      "id": "max-huge",
