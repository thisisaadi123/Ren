{
  "problem": "rotate-the-carousel",
  "version": 1,
  "seed": 30375013,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"slots":[1,2,3,4,5],"k":2},
      "expected": [4,5,1,2,3],
      "explanation": "4 and 5 wrap around to the front."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"slots":[9,8],"k":3},
      "expected": [8,9],
      "explanation": "Turning 3 steps is the same as turning 1."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"slots":[6,7,8],"k":0},
      "expected": [6,7,8],
      "explanation": "No turn at all."
    },
    {
      "id": "edge-single",
      "visible": false,
      "kind": "edge",
      "input": {"slots":[5],"k":1000000000},
      "expected": [5]
    },
    {
      "id": "edge-full-turn",
      "visible": false,
      "kind": "edge",
      "input": {"slots":[1,2,3],"k":3},
      "expected": [1,2,3]
    },
    {
      "id": "edge-n-minus-one",
      "visible": false,
      "kind": "edge",
      "input": {"slots":[1,2,3,4],"k":3},
      "expected": [2,3,4,1]
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 7","count":12}
    },
    {
