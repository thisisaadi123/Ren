{
  "problem": "soften-the-photo",
  "version": 1,
  "seed": 42432115,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"image":[[1,1,1],[1,0,1],[1,1,1]]},
      "expected": [[0,0,0],[0,0,0],[0,0,0]],
      "explanation": "A corner averages 4 pixels: 3 / 4 rounds down to 0. The centre averages all 9: 8 / 9 rounds down to 0."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"image":[[100,200,100],[200,50,200],[100,200,100]]},
      "expected": [[137,141,137],[141,138,141],[137,141,137]],
      "explanation": "The top-left corner averages 100, 200, 200 and 50, which is 550 / 4 = 137."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"image":[[7]]},
      "expected": [[7]],
      "explanation": "A single pixel only averages itself."
    },
    {
      "id": "sample1",
      "visible": true,
