{
  "problem": "everyone-elses-product",
  "version": 1,
  "seed": 85499421,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"nums":[1,2,-1,2]},
      "expected": [-4,-2,4,-2],
      "explanation": "For index 0: 2 × -1 × 2 = -4."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"nums":[2,0,-2]},
      "expected": [0,-4,0],
      "explanation": "Only index 1 skips the zero, so only its product isn't 0."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"nums":[0,1,0]},
      "expected": [0,0,0],
      "explanation": "With two zeros, every product includes a zero."
    },
    {
      "id": "edge-two",
      "visible": false,
      "kind": "edge",
      "input": {"nums":[2,-2]},
      "expected": [-2,2]
    },
    {
      "id": "edge-all-ones",
      "visible": false,
      "kind": "edge",
      "input": {"nums":[1,1,1,1]},
      "expected": [1,1,1,1]
    },
    {
      "id": "edge-single-zero-end",
      "visible": false,
      "kind": "edge",
      "input": {"nums":[2,2,2,0]},
      "expected": [0,0,0,8]
    },
