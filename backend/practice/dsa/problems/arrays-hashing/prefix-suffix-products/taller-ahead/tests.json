{
  "problem": "taller-ahead",
  "version": 1,
  "seed": 28486682,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"heights":[4,9,2,7,3]},
      "expected": [9,7,7,3,-1],
      "explanation": "After building 0 the tallest is 9; after building 1 it's 7."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"heights":[5]},
      "expected": [-1],
      "explanation": "The last building has nothing after it."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"heights":[2,2,2]},
      "expected": [2,2,-1],
      "explanation": "Equal heights still count."
    },
    {
      "id": "edge-increasing",
      "visible": false,
      "kind": "edge",
      "input": {"heights":[1,2,3,4,5]},
      "expected": [5,5,5,5,-1]
    },
    {
      "id": "edge-decreasing",
      "visible": false,
      "kind": "edge",
      "input": {"heights":[5,4,3,2,1]},
      "expected": [4,3,2,1,-1]
    },
    {
      "id": "edge-two",
      "visible": false,
      "kind": "edge",
      "input": {"heights":[10,1]},
      "expected": [1,-1]
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 10 --lo 1 --hi 20","count":10}
    },
    {
      "id": "mid",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 2000","count":4}
    },
    {
      "id": "max",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 100000","count":2}
    },
    {
      "id": "max-increasing",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 100000 --shape increasing"}
    },
    {
      "id": "max-decreasing",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 100000 --shape decreasing"}
    }
  ]
}
