{
  "problem": "shift-families",
  "version": 1,
  "seed": 57965115,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["abc","bcd","xyz","az","ba","a"]},
      "expected": 3,
      "explanation": "abc, bcd and xyz are one family; az and ba are another (shift az by 1); a is on its own."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["hello","hello"]},
      "expected": 1,
      "explanation": "Identical words are one family."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["a","aa"]},
      "expected": 2,
      "explanation": "Words of different lengths can never be shifts of each other."
    },
    {
      "id": "edge-wrap",
      "visible": false,
      "kind": "edge",
      "input": {"words":["zab","abc"]},
      "expected": 1
    },
    {
      "id": "edge-single",
      "visible": false,
      "kind": "edge",
      "input": {"words":["q"]},
      "expected": 1
    },
    {
      "id": "edge-length-only",
      "visible": false,
      "kind": "edge",
      "input": {"words":["a","b","c","aa","bb"]},
      "expected": 2
    },
