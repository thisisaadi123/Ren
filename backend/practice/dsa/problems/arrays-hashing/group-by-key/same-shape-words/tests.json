{
  "problem": "same-shape-words",
  "version": 1,
  "seed": 39506598,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["feet","moon","moan","deed"],"pattern":"boot"},
      "expected": 2,
      "explanation": "feet and moon follow the shape x y y z; moan and deed don't."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["a","b","c"],"pattern":"z"},
      "expected": 3,
      "explanation": "Every one-letter word has the same shape."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["cc","ab"],"pattern":"xy"},
      "expected": 1,
      "explanation": "\"cc\" repeats a letter where the pattern doesn't."
    },
    {
      "id": "edge-length-differs",
      "visible": false,
      "kind": "edge",
      "input": {"words":["abc","ab"],"pattern":"ab"},
      "expected": 1
    },
    {
      "id": "edge-all-same-letter",
      "visible": false,
      "kind": "edge",
      "input": {"words":["aaa","bbb","abb"],"pattern":"qqq"},
      "expected": 2
    },
    {
      "id": "edge-long",
      "visible": false,
      "kind": "edge",
      "input": {"words":["abcdefghijklmnopqrst"],"pattern":"tsrqponmlkjihgfedcba"},
      "expected": 1
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 12 --length 3 --alphabet abc","count":8}
    },
    {
      "id": "mid",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 1000","count":6}
    },
    {
      "id": "binary",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 2000 --length 6 --alphabet ab","count":4}
    },
    {
      "id": "max",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 10000 --length 20 --alphabet abcdef","count":2}
    },
    {
      "id": "max-short",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 10000 --length 3 --alphabet abc"}
    }
  ]
