    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"sales":[3,-1,4,1,5],"queries":[[0,2],[1,4],[3,3]]},
      "expected": [6,9,1],
      "explanation": "3 - 1 + 4 = 6; -1 + 4 + 1 + 5 = 9; day 3 alone is 1."
    },
    {
      "id": "ex2",
