{
  "problem": "first-k-missing",
  "version": 1,
  "seed": 59520028,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"nums":[3,-1,4,5,5],"k":3},
      "expected": [1,2,6],
      "explanation": "1 and 2 are missing, then 3, 4 and 5 are taken, so 6."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"nums":[2,3,4],"k":3},
      "expected": [1,5,6],
      "explanation": "Past the list, 5 and 6 are free."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"nums":[-2,-3,4],"k":2},
      "expected": [1,2],
      "explanation": "Negatives never block anything."
    },
    {
      "id": "edge-all-present",
      "visible": false,
      "kind": "edge",
      "input": {"nums":[1,2,3],"k":2},
      "expected": [4,5]
    },
    {
      "id": "edge-big-values",
      "visible": false,
      "kind": "edge",
      "input": {"nums":[5,6,7],"k":7},
      "expected": [1,2,3,4,8,9,10]
    },
    {
      "id": "edge-single",
      "visible": false,
      "kind": "edge",
      "input": {"nums":[1],"k":1},
      "expected": [2]
    },
    {
      "id": "edge-zeros",
      "visible": false,
      "kind": "edge",
      "input": {"nums":[0,0,0],"k":4},
      "expected": [1,2,3,4]
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 10 --k 5 --lo -3 --hi 15","count":16}
    },
    {
      "id": "mid",
      "visible": false,
