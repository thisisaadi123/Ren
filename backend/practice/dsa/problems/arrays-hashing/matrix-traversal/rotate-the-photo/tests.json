  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"photo":[[1,2,3],[4,5,6],[7,8,9]]},
      "expected": [[7,4,1],[8,5,2],[9,6,3]],
      "explanation": "The left column, read bottom to top, becomes the top row."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"photo":[[1,2],[3,4]]},
      "expected": [[3,1],[4,2]],
      "explanation": "Each corner moves one step clockwise."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"photo":[[5]]},
      "expected": [[5]],
      "explanation": "A single pixel doesn't move."
