    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"plain":"hello world","coded":"ifmmp xpsme","message":"xpsme ifmmp"},
      "expected": "world hello",
      "explanation": "Each letter was shifted forward by one, so x → w, p → o and so on."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"plain":"hello world","coded":"ifmmp xpsme","message":"fbu"},
      "expected": "e??",
      "explanation": "f is known to stand for e, but b and u never appeared in `coded`."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"plain":"abcdefghijklmnopqrstuvwxy","coded":"defghijklmnopqrstuvwxyzab","message":"cab"},
      "expected": "zxy",
      "explanation": "25 coded letters are known, and c is the only one missing, so it must stand for z, the only unused plain letter."
    },
