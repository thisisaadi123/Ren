    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"a":"abbccc","b":"cbbaaa"},
      "expected": true,
      "explanation": "Relabel a and c, then swap letters into place: both words use a, b, c with counts 1, 2, 3."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"a":"aab","b":"bcc"},
      "expected": false,
      "explanation": "The counts match (2 and 1), but `a` has no c, and a relabel can't create a new letter."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"a":"abc","b":"abcc"},
