{
  "problem": "justify-the-column",
  "version": 1,
  "seed": 97844502,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["the","quick","brown","fox","jumps"],"width":11},
      "expected": ["the   quick","brown   fox","jumps      "],
      "explanation": "Each of the first two lines has one gap, which takes all 3 spare spaces. The last line is left-aligned."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["we","are","at","sea","now"],"width":12},
      "expected": ["we   are  at","sea now     "],
      "explanation": "The first line has 5 spaces for 2 gaps, so the left gap gets 3 and the right gap gets 2."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["column","a"],"width":6},
      "expected": ["column","a     "],
      "explanation": "`column` fills its line exactly, and `a` is the left-aligned last line."
    },
