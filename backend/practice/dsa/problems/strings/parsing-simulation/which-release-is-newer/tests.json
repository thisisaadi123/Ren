{
  "problem": "which-release-is-newer",
  "version": 1,
  "seed": 21970312,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"a":"1.2","b":"1.10"},
      "expected": -1,
      "explanation": "The second revisions are 2 and 10, and 10 is bigger, so `b` is newer."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"a":"3.0.0","b":"3"},
      "expected": 0,
      "explanation": "`b`'s missing revisions count as 0, so both are 3.0.0."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"a":"2.007.1","b":"2.7"},
      "expected": 1,
      "explanation": "`007` equals `7`; then `a` has revision 1 where `b` has an implied 0."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"a":"12345678901234567890123.1","b":"99.99"},
      "expected": 1
    },
