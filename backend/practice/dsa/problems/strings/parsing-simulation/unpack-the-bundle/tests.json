{
  "problem": "unpack-the-bundle",
  "version": 1,
  "seed": 97960536,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"bundle":"3#a#10#2#hi"},
      "expected": ["a#1","","hi"],
      "explanation": "`3#` takes `a#1`, `0#` is an empty string, and `2#` takes `hi`."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"bundle":"11#hello world"},
      "expected": ["hello world"],
      "explanation": "The length has two digits, so the string is the next 11 characters."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"bundle":""},
      "expected": [],
      "explanation": "An empty bundle packs an empty list."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"bundle":"2###1#23#12#"},
      "expected": ["##","2","12#"]
    },
    {
      "id": "edge-one-empty",
      "visible": false,
      "kind": "edge",
      "input": {"bundle":"0#"},
      "expected": [""]
    },
    {
      "id": "edge-many-empty",
      "visible": false,
      "kind": "edge",
      "input": {"bundle":"0#0#0#0#"},
      "expected": ["","","",""]
    },
    {
      "id": "edge-hashes",
      "visible": false,
      "kind": "edge",
      "input": {"bundle":"12#############1##0#"},
      "expected": ["############","#",""]
    },
    {
      "id": "edge-digits-inside",
      "visible": false,
      "kind": "edge",
      "input": {"bundle":"5#12#342#5#1#0"},
      "expected": ["12#34","5#","0"]
    },
    {
      "id": "edge-spaces",
      "visible": false,
      "kind": "edge",
      "input": {"bundle":"3#   1# "},
      "expected": ["   "," "]
    },
    {
      "id": "edge-looks-like-length",
      "visible": false,
      "kind": "edge",
      "input": {"bundle":"5#3#abc3#10#1#1"},
      "expected": ["3#abc","10#","1"]
    },
    {
      "id": "edge-long-length",
      "visible": false,
      "kind": "edge",
      "input": {"bundle":"120#xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"},
      "expected": ["xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"]
    },
    {
      "id": "edge-single-char",
      "visible": false,
      "kind": "edge",
      "input": {"bundle":"1#~"},
      "expected": ["~"]
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--count 4 --maxlen 6","count":8}
    },
    {
      "id": "mid",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--count 60 --maxlen 20 --shape printable","count":3}
    },
    {
      "id": "max-many",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--count 30000 --maxlen 3"}
    },
    {
      "id": "max-long",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--count 6 --maxlen 20000 --shape printable"}
    },
    {
      "id": "max-hashes",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--count 20000 --maxlen 5 --alpha #0"}
    }
  ]
}
