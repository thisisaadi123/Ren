{
  "problem": "read-the-meter",
  "version": 1,
  "seed": 60938769,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"text":"   -1_024 volts"},
      "expected": -1024,
      "explanation": "The spaces are skipped, the sign is read, and the `_` between `1` and `024` is ignored."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"text":"42__7"},
      "expected": 42,
      "explanation": "The first `_` is followed by another `_`, not a digit, so the reading stops after `42`."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"text":"reading 17"},
      "expected": 0,
      "explanation": "The text starts with a letter, so no digit is read."
    },
