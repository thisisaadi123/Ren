{
  "problem": "sort-the-scoreboard",
  "version": 1,
  "seed": 26518921,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"scores":[5,-2,9,0]},
      "expected": [-2,0,5,9],
      "explanation": "Lowest to highest."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"scores":[3,3,1]},
      "expected": [1,3,3],
      "explanation": "Repeats stay."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"scores":[7]},
      "expected": [7],
      "explanation": "One score is already sorted."
    },
    {
      "id": "edge-sorted",
      "visible": false,
      "kind": "edge",
      "input": {"scores":[1,2,3,4]},
      "expected": [1,2,3,4]
    },
    {
      "id": "edge-reversed",
      "visible": false,
      "kind": "edge",
      "input": {"scores":[4,3,2,1]},
      "expected": [1,2,3,4]
    },
    {
      "id": "edge-extremes",
      "visible": false,
      "kind": "edge",
      "input": {"scores":[1000000000,-1000000000,0]},
      "expected": [-1000000000,0,1000000000]
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
