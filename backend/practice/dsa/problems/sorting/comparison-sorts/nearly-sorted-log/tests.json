      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"times":[2,1,3],"k":1},
      "expected": [1,2,3],
      "explanation": "Only neighbours are swapped."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"times":[5,6,7],"k":0},
      "expected": [5,6,7],
      "explanation": "With k = 0 the log is already sorted."
