{
  "problem": "prefix-scores",
  "version": 1,
  "seed": 86275419,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["abc","ab","bc","b"]},
      "expected": [5,4,3,2],
      "explanation": "\"abc\": \"a\" scores 2, \"ab\" 2, \"abc\" 1, so 5."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["abcd"]},
      "expected": [4],
      "explanation": "Each of the four prefixes scores 1."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["a","a"]},
      "expected": [2,2],
      "explanation": "Both copies start with \"a\"."
    },
    {
      "id": "sample1",
