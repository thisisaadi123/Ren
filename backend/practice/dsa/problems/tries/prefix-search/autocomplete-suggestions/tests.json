{
  "problem": "autocomplete-suggestions",
  "version": 1,
  "seed": 11881246,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"products":["mobile","mouse","moneypot","monitor","mousepad"],"typed":"mouse"},
      "expected": [["mobile","moneypot","monitor"],["mobile","moneypot","monitor"],["mouse","mousepad"],["mouse","mousepad"],["mouse","mousepad"]],
      "explanation": "After \"m\" and \"mo\" the three smallest are shown; from \"mou\" on, only two products match."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"products":["havana"],"typed":"tatiana"},
      "expected": [[],[],[],[],[],[],[]],
      "explanation": "Nothing ever matches."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"products":["bags","baggage","banner","box","cloths"],"typed":"bags"},
      "expected": [["baggage","bags","banner"],["baggage","bags","banner"],["baggage","bags"],["bags"]],
      "explanation": "Suggestions narrow as more letters are typed."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"products":["a","a","ab","b"],"typed":"ab"},
      "expected": [["a","a","ab"],["ab"]]
    },
    {
      "id": "edge-exact",
      "visible": false,
      "kind": "edge",
      "input": {"products":["abc"],"typed":"abc"},
      "expected": [["abc"],["abc"],["abc"]]
    },
    {
      "id": "edge-dupes",
      "visible": false,
      "kind": "edge",
      "input": {"products":["x","x","x","x"],"typed":"x"},
      "expected": [["x","x","x"]]
    },
    {
      "id": "edge-miss-then",
      "visible": false,
      "kind": "edge",
      "input": {"products":["ab","ac"],"typed":"ba"},
      "expected": [[],[]]
    },
    {
      "id": "edge-longer-typed",
      "visible": false,
      "kind": "edge",
      "input": {"products":["a"],"typed":"aa"},
      "expected": [["a"],[]]
    },
    {
      "id": "random-small",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 5 --m 3 --alpha ab --hi 4","count":12}
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 30 --m 6","count":8}
    },
    {
      "id": "dense",
      "visible": false,
