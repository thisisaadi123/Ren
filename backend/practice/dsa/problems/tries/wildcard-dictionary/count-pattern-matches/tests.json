{
  "problem": "count-pattern-matches",
  "version": 1,
  "seed": 40807536,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["cat","car","cut","cart"],"patterns":["ca.","c.t","..rt"]},
      "expected": [2,2,1],
      "explanation": "\"ca.\" matches cat and car; \"c.t\" matches cat and cut; \"..rt\" matches cart."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["a","a","b"],"patterns":["a","."]},
      "expected": [2,3],
      "explanation": "Repeated words count each time."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"words":["xy"],"patterns":["x","xyz"]},
      "expected": [0,0],
      "explanation": "The lengths must match."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"words":["ab","ba","aa"],"patterns":[".a","a.",".."]},
      "expected": [2,2,3]
    },
    {
      "id": "edge-no-dots",
      "visible": false,
      "kind": "edge",
      "input": {"words":["abc","abd"],"patterns":["abc"]},
      "expected": [1]
    },
    {
      "id": "edge-two-dots",
      "visible": false,
      "kind": "edge",
      "input": {"words":["abc","xbz","abz"],"patterns":[".b."]},
      "expected": [3]
    },
    {
      "id": "edge-long",
      "visible": false,
      "kind": "edge",
      "input": {"words":["abcdefghij"],"patterns":["abcdefgh..","abcdefghi"]},
      "expected": [1,0]
    },
    {
      "id": "edge-none",
      "visible": false,
      "kind": "edge",
      "input": {"words":["a"],"patterns":["b","c"]},
      "expected": [0,0]
    },
    {
      "id": "random-small",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 5 --q 3 --alpha ab --hi 3","count":12}
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 40 --q 20","count":8}
    },
    {
      "id": "mid",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 1000 --q 1000 --alpha abcd --hi 8","count":6}
    },
    {
      "id": "max",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 5000 --alpha abc --lo 5 --hi 10","count":3}
    },
    {
      "id": "max-short",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 5000 --alpha ab --lo 1 --hi 4","count":3}
    },
    {
      "id": "max-wide",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 5000 --alpha abcdefghijklmnopqrstuvwxyz --lo 3 --hi 10","count":3}
    },
    {
      "id": "max-same-length",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 5000 --alpha ab --lo 10 --hi 10","count":2}
    }
  ]
}
