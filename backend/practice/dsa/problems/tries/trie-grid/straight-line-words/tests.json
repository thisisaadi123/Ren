{
  "problem": "straight-line-words",
  "version": 1,
  "seed": 46591394,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"board":["cat","xax","tac"],"words":["cat","tac","aaa","cax"]},
      "expected": ["aaa","cat","tac"],
      "explanation": "\"cat\" reads across the top, \"tac\" along the bottom and \"aaa\" down the middle. \"cax\" would have to bend."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"board":["abc"],"words":["cba","ac"]},
      "expected": ["cba"],
      "explanation": "Backwards counts; skipping a letter doesn't."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"board":["z"],"words":["z","z"]},
      "expected": ["z"],
      "explanation": "Listed once."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"board":["ab","cd"],"words":["ad","da","bc","abdc"]},
      "expected": ["ad","bc","da"]
    },
