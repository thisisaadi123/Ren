{
  "problem": "xor-under-a-cap",
  "version": 1,
  "seed": 86992792,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"nums":[0,1,2,3,4],"queries":[[3,1],[1,3],[5,6]]},
      "expected": [3,3,7],
      "explanation": "For [3, 1] only 0 and 1 are allowed: 3 XOR 0 = 3. For [5, 6], 5 XOR 2 = 7."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"nums":[5,2,4,6,6,3],"queries":[[12,4],[8,1],[6,3]]},
      "expected": [15,-1,5],
      "explanation": "No number is at most 1, so the second answer is -1."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"nums":[7],"queries":[[7,7]]},
      "expected": [0],
      "explanation": "7 XOR 7 = 0."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"nums":[1,2],"queries":[[0,0],[0,1],[3,2]]},
      "expected": [-1,1,2]
    },
    {
      "id": "edge-cap-exact",
