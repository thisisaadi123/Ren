{
  "problem": "laps-around-the-loop",
  "version": 1,
  "seed": 5410670,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":{"values":[5,1,7,3],"cycle_at":1},"steps":[0,2,4,9]},
      "expected": [5,7,1,3],
      "explanation": "The loop is 1 → 7 → 3 → 1… After 4 steps the runner is back on 1; 5 more steps are one lap of the three-node loop plus two nodes, ending on 3."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[4,8,6],"steps":[2,3,1000000000000000]},
      "expected": [6,-1,-1],
      "explanation": "There's no loop: 2 steps reach the last node, and any more fall off.",
      "no_brute": true
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":{"values":[9],"cycle_at":0},"steps":[0,1,999999999999999]},
      "expected": [9,9,9],
      "explanation": "The only node points to itself, so the runner never moves anywhere else.",
      "no_brute": true
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"head":{"values":[1,2,3,4,5],"cycle_at":3},"steps":[3,4,5,6,7]},
      "expected": [4,5,4,5,4]
    },
    {
      "id": "edge-no-loop-edges",
      "visible": false,
      "kind": "edge",
      "input": {"head":[10,20],"steps":[0,1,2]},
      "expected": [10,20,-1]
    },
    {
      "id": "edge-single-no-loop",
      "visible": false,
      "kind": "edge",
      "input": {"head":[0],"steps":[0,1]},
      "expected": [0,-1]
    },
    {
      "id": "edge-loop-at-head",
      "visible": false,
      "kind": "edge",
      "input": {"head":{"values":[1,2,3],"cycle_at":0},"steps":[0,3,5,7,8]},
      "expected": [1,1,3,2,3]
    },
    {
      "id": "edge-self-loop-tail",
      "visible": false,
      "kind": "edge",
      "input": {"head":{"values":[1,2,3],"cycle_at":2},"steps":[0,1,2,3,50]},
      "expected": [1,2,3,3,3]
    },
    {
      "id": "edge-entry-boundaries",
      "visible": false,
      "kind": "edge",
      "input": {"head":{"values":[0,1,2,3,4,5],"cycle_at":2},"steps":[1,2,5,6,9,10]},
      "expected": [1,2,5,2,5,2]
    },
    {
      "id": "edge-huge-steps",
      "visible": false,
      "kind": "edge",
      "input": {"head":{"values":[7,8,9,10],"cycle_at":1},"steps":[1000000000000000,999999999999999,999999999999998]},
      "no_brute": true,
      "expected": [8,10,9]
    },
    {
      "id": "edge-huge-no-loop",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1,2,3],"steps":[1000000000000000,0]},
      "no_brute": true,
      "expected": [-1,1]
    },
    {
      "id": "edge-repeated-values",
      "visible": false,
      "kind": "edge",
      "input": {"head":{"values":[5,5,6,5],"cycle_at":2},"steps":[0,1,2,3,4,5]},
      "expected": [5,5,6,5,6,5]
    },
    {
      "id": "edge-max-values",
      "visible": false,
      "kind": "edge",
      "input": {"head":{"values":[1000000000,0],"cycle_at":1},"steps":[0,1,2]},
      "expected": [1000000000,0,0]
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 6 --q 5 --big 30 --span 9","count":20}
    },
    {
      "id": "random-12",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 12 --q 8 --big 60 --span 20","count":12}
    },
    {
      "id": "random-mid",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 1000 --q 1000","count":8}
    },
    {
      "id": "random-mid-head",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 1000 --q 1000 --loop head","count":3}
    },
    {
      "id": "random-mid-tail",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 1000 --q 1000 --loop tail","count":3}
    },
    {
      "id": "random-mid-none",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 1000 --q 1000 --loop none","count":3}
    },
    {
      "id": "max",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 100000 --q 100000","count":2}
    },
    {
