{
  "problem": "loop-in-the-track",
  "version": 1,
  "seed": 6512622,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":{"values":[3,2,0,-4],"cycle_at":1}},
      "expected": true,
      "explanation": "The last piece (−4) links back to the piece holding 2, so the train circles forever."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":{"values":[1,2],"cycle_at":-1}},
      "expected": false,
      "explanation": "The track ends after the second piece."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":{"values":[5],"cycle_at":0}},
      "expected": true,
      "explanation": "A single piece that points to itself is a loop."
    },
    {
