{
  "problem": "where-two-lines-meet",
  "version": 1,
  "seed": 8636278,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"headA":[4,1,8,9,5],"headB":{"values":[7,6,2],"join_at":2}},
      "expected": [8,9,5],
      "explanation": "The second line runs 7 → 6 → 2 and then continues on the first line's stop 8."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"headA":[3,11,20],"headB":[15,14]},
      "expected": [],
      "explanation": "The lines never share a stop."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"headA":[9,4,6],"headB":{"values":[],"join_at":0}},
      "expected": [9,4,6],
      "explanation": "The second line starts on the first line's very first stop."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"headA":[1,2,3,4],"headB":{"values":[10],"join_at":3}},
