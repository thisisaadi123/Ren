  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[[7,null],[13,0],[11,4],[10,2],[1,0]]},
      "expected": [[7,null],[13,0],[11,4],[10,2],[1,0]],
      "explanation": "The copy has the same shape: clue 13's shortcut leads back to clue 7, clue 11's to clue 1, and so on."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[[1,1],[2,1]]},
      "expected": [[1,1],[2,1]],
      "explanation": "Both shortcuts lead to the second clue, including its own."
    },
