{
  "problem": "swap-dance-partners",
  "version": 1,
  "seed": 39809553,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[1,2,3,4]},
      "expected": [2,1,4,3],
      "explanation": "Couples (1, 2) and (3, 4) each trade places."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[7,8,9]},
      "expected": [8,7,9],
      "explanation": "9 has no partner and stays last."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[]},
      "expected": [],
      "explanation": "No dancers, nothing to swap."
