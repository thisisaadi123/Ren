  "seed": 46690205,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[1,2,2,1]},
      "expected": true,
      "explanation": "Read backwards the digits are still 1, 2, 2, 1."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[3,1,4,1,3]},
      "expected": true,
      "explanation": "An odd length works too: the middle 4 is compared with nothing."
    },
