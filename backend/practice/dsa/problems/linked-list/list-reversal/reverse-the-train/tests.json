{
  "problem": "reverse-the-train",
  "version": 1,
  "seed": 101,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[1,2,3,4,5]},
      "expected": [5,4,3,2,1],
      "explanation": "The last car, 5, becomes the engine, and every link now points the other way."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[8,3]},
      "expected": [3,8],
      "explanation": "With two cars they simply swap places."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[]},
      "expected": [],
      "explanation": "An empty train stays empty."
    },
    {
      "id": "edge-one",
      "kind": "edge",
      "visible": false,
      "input": {"head":[42]},
      "expected": [42]
    },
    {
      "id": "edge-same",
      "kind": "edge",
      "visible": false,
      "input": {"head":[5,5,5]},
      "expected": [5,5,5]
    },
    {
      "id": "edge-negative",
      "kind": "edge",
      "visible": false,
      "input": {"head":[-1000000,0,1000000]},
      "expected": [1000000,0,-1000000]
    },
    {
      "id": "edge-three",
      "kind": "edge",
      "visible": false,
      "input": {"head":[1,2,3]},
      "expected": [3,2,1]
    },
    {
      "id": "random",
      "kind": "random",
      "visible": false,
      "generate": {"args":"--n 50","count":10}
    },
    {
      "id": "random-mid",
      "kind": "random",
      "visible": false,
      "generate": {"args":"--n 2000","count":6}
    },
    {
      "id": "max",
      "kind": "max",
      "visible": false,
      "generate": {"args":"--n 100000","count":2}
    },
    {
      "id": "max-ascending",
      "kind": "max",
      "visible": false,
      "generate": {"args":"--n 100000 --shape ascending"}
    }
  ]
}
