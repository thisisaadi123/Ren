{
  "problem": "flip-a-stretch",
  "version": 1,
  "seed": 69524970,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[1,2,3,4,5],"left":2,"right":4},
      "expected": [1,4,3,2,5],
      "explanation": "Positions 2 to 4 (2, 3, 4) are flipped; 1 and 5 stay put."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[7,8,9],"left":1,"right":3},
      "expected": [9,8,7],
      "explanation": "The stretch is the whole list."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[5,6],"left":2,"right":2},
      "expected": [5,6],
      "explanation": "A stretch of one runner doesn't change anything."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"head":[1,2,3,4],"left":1,"right":2},
      "expected": [2,1,3,4]
    },
    {
      "id": "edge-single",
      "visible": false,
      "kind": "edge",
      "input": {"head":[3],"left":1,"right":1},
      "expected": [3]
    },
    {
      "id": "edge-prefix",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1,2,3,4,5],"left":1,"right":3},
      "expected": [3,2,1,4,5]
    },
    {
      "id": "edge-suffix",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1,2,3,4,5],"left":3,"right":5},
      "expected": [1,2,5,4,3]
    },
    {
      "id": "edge-two-at-end",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1,2,3,4,5],"left":4,"right":5},
      "expected": [1,2,3,5,4]
    },
    {
      "id": "edge-pair-middle",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1,2,3,4],"left":2,"right":3},
      "expected": [1,3,2,4]
    },
    {
      "id": "edge-same-values",
      "visible": false,
      "kind": "edge",
      "input": {"head":[2,2,1,2],"left":1,"right":4},
      "expected": [2,1,2,2]
    },
    {
      "id": "edge-extremes",
      "visible": false,
      "kind": "edge",
      "input": {"head":[-100000,0,100000],"left":1,"right":3},
      "expected": [100000,0,-100000]
    },
