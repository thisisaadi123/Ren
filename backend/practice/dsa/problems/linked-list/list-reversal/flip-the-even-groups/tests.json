{
  "problem": "flip-the-even-groups",
  "version": 1,
  "seed": 82239031,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[5,2,6,3,9,1,7,3,8,4]},
      "expected": [5,6,2,3,9,1,4,8,3,7],
      "explanation": "Groups are [5], [2, 6], [3, 9, 1], [7, 3, 8, 4]; the two groups of even size are flipped."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[1,1,0,6,5]},
      "expected": [1,0,1,5,6],
      "explanation": "The last group was planned with 3 nodes but only has 2 (6, 5), so it is flipped."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[2,1]},
      "expected": [2,1],
      "explanation": "Group sizes are 1 and 1: the second group only got one node, so nothing flips."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"head":[8]},
      "expected": [8]
    },
