{
  "problem": "flip-in-batches",
  "version": 1,
  "seed": 94960710,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[1,2,3,4,5,6,7,8],"k":3},
      "expected": [3,2,1,6,5,4,7,8],
      "explanation": "Batches [1, 2, 3] and [4, 5, 6] are flipped; only 7 and 8 are left, fewer than 3, so they stay."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[1,2,3,4],"k":2},
      "expected": [2,1,4,3],
      "explanation": "Two full batches of two, each flipped."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[4,5,6],"k":1},
      "expected": [4,5,6],
      "explanation": "Flipping a batch of one crate changes nothing."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"head":[9,8,7,6,5],"k":5},
      "expected": [5,6,7,8,9]
    },
    {
      "id": "edge-single",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1],"k":1},
      "expected": [1]
    },
    {
      "id": "edge-k-equals-n",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1,2,3,4],"k":4},
      "expected": [4,3,2,1]
    },
    {
      "id": "edge-leftover-one",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1,2,3,4,5],"k":2},
      "expected": [2,1,4,3,5]
    },
    {
      "id": "edge-leftover-k-minus-1",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1,2,3,4,5,6,7],"k":4},
      "expected": [4,3,2,1,5,6,7]
    },
    {
      "id": "edge-exact-multiple",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1,2,3,4,5,6],"k":3},
      "expected": [3,2,1,6,5,4]
    },
    {
      "id": "edge-two-k-n-minus-1",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1,2,3],"k":2},
      "expected": [2,1,3]
    },
    {
      "id": "edge-same-values",
      "visible": false,
      "kind": "edge",
      "input": {"head":[3,3,3,3],"k":3},
      "expected": [3,3,3,3]
    },
    {
      "id": "edge-extremes",
      "visible": false,
      "kind": "edge",
      "input": {"head":[-1000000,1000000,0,-1000000,1000000],"k":2},
      "expected": [1000000,-1000000,-1000000,0,1000000]
    },
    {
      "id": "edge-three-batches",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1,2,3,4,5,6,7,8,9],"k":3},
      "expected": [3,2,1,6,5,4,9,8,7]
    },
