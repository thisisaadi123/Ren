{
  "problem": "cancel-out-runs",
  "version": 1,
  "seed": 10705086,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[3,4,-4,1,-3,2]},
      "expected": [3],
      "explanation": "4 and −4 cancel right away. Later the sheet reads 3, 1, −3, 2, and 1 + (−3) + 2 = 0 is crossed out."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[1,2,-3,5]},
      "expected": [5],
      "explanation": "The first three amounts add up to 0, so they vanish before 5 is copied."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[0,7,0]},
      "expected": [7],
      "explanation": "A single 0 is a run that sums to 0 on its own."
    },
