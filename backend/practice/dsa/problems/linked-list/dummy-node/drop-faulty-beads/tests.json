{
  "problem": "drop-faulty-beads",
  "version": 1,
  "seed": 76423326,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[1,3,2,3,4],"bad":3},
      "expected": [1,2,4],
      "explanation": "Both beads of colour 3 are removed; the others keep their order."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[5,5,5],"bad":5},
      "expected": [],
      "explanation": "Every bead is faulty, so nothing is left."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[],"bad":7},
      "expected": [],
      "explanation": "An empty thread stays empty."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"head":[2,7,7,2],"bad":2},
      "expected": [7,7]
    },
    {
      "id": "edge-single-bad",
      "visible": false,
      "kind": "edge",
      "input": {"head":[4],"bad":4},
      "expected": []
    },
    {
