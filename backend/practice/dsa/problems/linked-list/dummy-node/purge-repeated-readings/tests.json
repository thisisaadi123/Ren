{
  "problem": "purge-repeated-readings",
  "version": 1,
  "seed": 13580239,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[1,2,2,3,4,4,4,5]},
      "expected": [1,3,5],
      "explanation": "Readings 2 and 4 repeat, so every copy of them goes."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[7,7,8]},
      "expected": [8],
      "explanation": "The repeated run at the very front is removed, so 8 becomes the head."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[3,3]},
      "expected": [],
      "explanation": "Both nodes hold the same reading, so nothing is left."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"head":[-2,-1,0]},
      "expected": [-2,-1,0]
    },
    {
