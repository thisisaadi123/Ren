{
  "problem": "slot-into-sorted-chain",
  "version": 1,
  "seed": 64574918,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[1,3,5],"value":4},
      "expected": [1,3,4,5],
      "explanation": "4 goes between 3 and 5."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[2,6],"value":1},
      "expected": [1,2,6],
      "explanation": "1 is smaller than every tag, so it becomes the new head."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[],"value":7},
      "expected": [7],
      "explanation": "Inserting into an empty chain gives a chain of one node."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"head":[1,1,2],"value":1},
      "expected": [1,1,1,2]
    },
    {
      "id": "edge-at-end",
      "visible": false,
      "kind": "edge",
      "input": {"head":[1,2,3],"value":9},
      "expected": [1,2,3,9]
    },
    {
      "id": "edge-all-equal",
      "visible": false,
      "kind": "edge",
      "input": {"head":[5,5,5],"value":5},
      "expected": [5,5,5,5]
    },
    {
      "id": "edge-negatives",
      "visible": false,
      "kind": "edge",
      "input": {"head":[-8,-3,-3,0],"value":-4},
      "expected": [-8,-4,-3,-3,0]
    },
    {
      "id": "edge-single-smaller",
      "visible": false,
      "kind": "edge",
      "input": {"head":[10],"value":-10},
      "expected": [-10,10]
    },
    {
      "id": "edge-single-larger",
      "visible": false,
      "kind": "edge",
      "input": {"head":[10],"value":10},
      "expected": [10,10]
    },
    {
      "id": "edge-extremes-front",
      "visible": false,
      "kind": "edge",
      "input": {"head":[-1000000,1000000],"value":-1000000},
      "expected": [-1000000,-1000000,1000000]
    },
    {
      "id": "edge-extremes-back",
      "visible": false,
      "kind": "edge",
      "input": {"head":[-1000000,1000000],"value":1000000},
      "expected": [-1000000,1000000,1000000]
    },
    {
      "id": "edge-middle",
      "visible": false,
      "kind": "edge",
      "input": {"head":[-1000000,1000000],"value":0},
      "expected": [-1000000,0,1000000]
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 8 --span 6","count":7}
    },
    {
      "id": "random-mid",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 2000","count":3}
    },
    {
      "id": "max",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 100000"}
    },
    {
      "id": "max-front",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 100000 --where front"}
    },
    {
      "id": "max-back",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 100000 --where back"}
    }
  ]
}
