{
  "problem": "low-notes-first",
  "version": 1,
  "seed": 56204580,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[5,1,8,3,5,2],"pivot":5},
      "expected": [1,3,2,5,8,5],
      "explanation": "1, 3, 2 are below 5 and keep their order; then 5, 8, 5 in their original order."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[9,7,4],"pivot":5},
      "expected": [4,9,7],
      "explanation": "Only 4 is low, so it moves to the front."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[],"pivot":0},
      "expected": [],
      "explanation": "No notes, nothing to rearrange."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"head":[2,2,2],"pivot":2},
      "expected": [2,2,2]
    },
    {
