{
  "problem": "closest-to-zero-first",
  "version": 1,
  "seed": 78257416,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[3,-1,-4,2,4]},
      "expected": [-1,2,3,-4,4],
      "explanation": "Distances are 3, 1, 4, 2, 4. The two 4s keep their log order: −4 came before 4."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[5,0,-5]},
      "expected": [0,5,-5],
      "explanation": "0 is closest; 5 and −5 tie and stay in log order."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[]},
      "expected": [],
      "explanation": "An empty log stays empty."
    },
    {
