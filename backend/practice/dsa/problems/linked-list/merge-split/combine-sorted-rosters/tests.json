{
  "problem": "combine-sorted-rosters",
  "version": 1,
  "seed": 31523436,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"first":[1,3,3,7],"second":[2,3,8]},
      "expected": [1,2,3,7,8],
      "explanation": "3 appears three times across the two rosters but is written once."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"first":[],"second":[4,4,5]},
      "expected": [4,5],
      "explanation": "Only the second roster has members; its duplicate 4 is still merged into one."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"first":[-2,0],"second":[-2,0]},
      "expected": [-2,0],
      "explanation": "Both clubs have exactly the same members."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"first":[],"second":[]},
      "expected": []
    },
    {
      "id": "edge-first-only",
      "visible": false,
      "kind": "edge",
      "input": {"first":[1,1,1],"second":[]},
      "expected": [1]
    },
    {
      "id": "edge-disjoint",
      "visible": false,
      "kind": "edge",
      "input": {"first":[1,2],"second":[5,6]},
      "expected": [1,2,5,6]
    },
    {
      "id": "edge-second-lower",
      "visible": false,
      "kind": "edge",
      "input": {"first":[5,6],"second":[1,2,2]},
      "expected": [1,2,5,6]
    },
    {
      "id": "edge-interleave",
      "visible": false,
      "kind": "edge",
      "input": {"first":[1,3,5],"second":[2,4,6]},
      "expected": [1,2,3,4,5,6]
    },
    {
      "id": "edge-single-each-equal",
      "visible": false,
      "kind": "edge",
      "input": {"first":[9],"second":[9]},
      "expected": [9]
    },
    {
      "id": "edge-extremes",
      "visible": false,
      "kind": "edge",
      "input": {"first":[-1000000,1000000],"second":[-1000000,0,1000000,1000000]},
      "expected": [-1000000,0,1000000]
    },
    {
      "id": "edge-leftover-repeats",
      "visible": false,
      "kind": "edge",
      "input": {"first":[1],"second":[2,2,3,3]},
      "expected": [1,2,3]
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 5 --m 5 --span 6","count":6}
    },
    {
      "id": "random-mid",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 1000 --m 800 --span 500","count":3}
    },
    {
      "id": "max",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 50000 --m 50000"}
    },
    {
      "id": "max-dense",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 50000 --m 50000 --span 1000"}
    },
    {
      "id": "max-disjoint",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 50000 --m 50000 --shape disjoint"}
    },
    {
      "id": "max-interleave",
      "visible": false,
      "kind": "max",
      "generate": {"args":"--n 50000 --m 50000 --shape interleave"}
    }
  ]
}
