{
  "problem": "merge-checkout-queues",
  "version": 1,
  "seed": 90998158,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"queues":[[1,4,5],[1,3,4],[2,6]]},
      "expected": [1,1,2,3,4,4,5,6],
      "explanation": "All eight tickets in one sorted line."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"queues":[]},
      "expected": [],
      "explanation": "No queues at all gives an empty list."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"queues":[[],[3],[]]},
      "expected": [3],
      "explanation": "Empty queues contribute nothing."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"queues":[[2,2],[1,3]]},
      "expected": [1,2,2,3]
    },
