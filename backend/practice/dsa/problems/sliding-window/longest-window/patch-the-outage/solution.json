   "code": {
    "python": "class Solution:\n    def longestOnline(self, status: List[int], k: int) -> int:\n        n, best = len(status), 0\n        for i in range(n):\n            zeros, j = 0, i\n            while j < n and zeros + (status[j] == 0) <= k:\n                zeros += status[j] == 0\n                j += 1\n            best = max(best, j - i)\n        return best\n",
    "java": "class Solution {\n    public int longestOnline(int[] status, int k) {\n        int n = status.length, best = 0;\n        for (int i = 0; i < n; i++) {\n            int zeros = 0, j = i;\n            while (j < n && zeros + (status[j] == 0 ? 1 : 0) <= k) zeros += status[j++] == 0 ? 1 : 0;\n            best = Math.max(best, j - i);\n        }\n        return best;\n    }\n}\n",
    "cpp": "class Solution {\npublic:\n    int longestOnline(vector<int>& status, int k) {\n        int n = status.size(), best = 0;\n        for (int i = 0; i < n; i++) {\n            int zeros = 0, j = i;\n            while (j < n && zeros + (status[j] == 0) <= k) zeros += status[j++] == 0;\n            best = max(best, j - i);\n        }\n        return best;\n    }\n};\n",
    "c": "int longestOnline(int* status, int statusSize, int k) {\n    int n = statusSize, best = 0;\n    for (int i = 0; i < n; i++) {\n        int zeros = 0, j = i;\n        while (j < n && zeros + (status[j] == 0) <= k) zeros += status[j++] == 0;\n        if (j - i > best) best = j - i;\n    }\n    return best;\n}\n"
   },
