   "code": {
    "python": "class Solution:\n    def mostVowels(self, s: str, k: int) -> int:\n        best = 0\n        for i in range(len(s) - k + 1):\n            count = sum(1 for c in s[i:i + k] if c in \"aeiou\")\n            best = max(best, count)\n        return best\n",
    "java": "class Solution {\n    public int mostVowels(String s, int k) {\n        int best = 0;\n        for (int i = 0; i + k <= s.length(); i++) {\n            int count = 0;\n            for (int j = i; j < i + k; j++) if (\"aeiou\".indexOf(s.charAt(j)) >= 0) count++;\n            best = Math.max(best, count);\n        }\n        return best;\n    }\n}\n",
    "cpp": "class Solution {\npublic:\n    int mostVowels(string& s, int k) {\n        int best = 0;\n        for (int i = 0; i + k <= (int) s.size(); i++) {\n            int count = 0;\n            for (int j = i; j < i + k; j++) if (string(\"aeiou\").find(s[j]) != string::npos) count++;\n            best = max(best, count);\n        }\n        return best;\n    }\n};\n",
    "c": "int mostVowels(char* s, int k) {\n    int n = strlen(s), best = 0;\n    for (int i = 0; i + k <= n; i++) {\n        int count = 0;\n        for (int j = i; j < i + k; j++) if (strchr(\"aeiou\", s[j])) count++;\n        if (count > best) best = count;\n    }\n    return best;\n}\n"
   },
