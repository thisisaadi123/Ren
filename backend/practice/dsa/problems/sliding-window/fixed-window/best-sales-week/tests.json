    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"sales":[4,-2,7,1,-5,3],"k":3},
      "expected": 9,
      "explanation": "Days 0–2 give 4 − 2 + 7 = 9, the best of the four stretches."
    },
