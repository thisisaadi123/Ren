      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"sales":[-3,-1,-4],"k":2},
      "expected": -4,
      "explanation": "Every stretch loses money; [-3, -1] loses the least."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
