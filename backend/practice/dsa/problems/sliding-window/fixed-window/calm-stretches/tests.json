  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"noise":[2,2,2,2,5,5,5,8],"k":3,"limit":4},
      "expected": 4,
      "explanation": "The first four windows total 6, 6, 9 and 12, all at most 4 × 3 = 12. [5,5,5] and [5,5,8] are too loud."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"noise":[1,2,3],"k":2,"limit":1},
      "expected": 0,
      "explanation": "The windows average 1.5 and 2.5, both above 1."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"noise":[6],"k":1,"limit":6},
      "expected": 1,
      "explanation": "An average exactly equal to the limit is calm."
