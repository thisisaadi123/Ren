      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"factors":[10,5,2,6],"cap":100},
      "expected": 8,
      "explanation": "[10], [5], [2], [6], [10,5], [5,2], [2,6] and [5,2,6]. [10,5,2] multiplies to exactly 100, which isn't under the cap."
