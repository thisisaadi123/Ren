{
  "problem": "depth-on-arrival",
  "version": 1,
  "seed": 77915594,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"keys":[50,30,70,60,65]},
      "expected": [1,2,2,3,4],
      "explanation": "60 goes right of 50 and left of 70 (depth 3); 65 then goes right of 60 (depth 4)."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"keys":[1,2,3,4]},
      "expected": [1,2,3,4],
      "explanation": "Sorted arrivals build a single chain."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"keys":[10,5,7,6]},
      "expected": [1,2,3,4],
      "explanation": "7 goes left of 10 then right of 5; 6 goes left, right and then left of 7."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"keys":[8,3,10,1,6,14,4,7,13]},
      "expected": [1,2,2,3,3,3,4,4,4]
    },
    {
