{
  "problem": "membership-register-edits",
  "version": 1,
  "seed": 93159019,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[50,30,70,20,40,60,80],"ops":[[0,50]]},
      "expected": [60,30,70,20,40,null,80],
      "explanation": "50 has two children, so it takes 60, the smallest key on its right side, and 60's old node is removed."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[50,30,70],"ops":[[1,35],[0,30]]},
      "expected": [50,35,70],
      "explanation": "35 hangs to the right of 30; deleting 30 then leaves its only child 35 in its place."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[],"ops":[[1,5],[1,5],[0,9]]},
      "expected": [5],
      "explanation": "The second insert of 5 and the delete of the missing 9 change nothing."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[8,4,12,2,6,10,14],"ops":[[0,4],[0,12],[1,11]]},
      "expected": [8,6,14,2,null,10,null,null,null,null,11]
    },
    {
