    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[20,10,30,5,15,25,40],"x":15},
      "expected": 20,
      "explanation": "15 has no right side, so the next number up is its ancestor 20."
    },
