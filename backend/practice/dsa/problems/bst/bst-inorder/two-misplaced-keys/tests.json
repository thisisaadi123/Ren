{
  "problem": "two-misplaced-keys",
  "version": 1,
  "seed": 482605,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[3,6,9,2,4,null,12]},
      "expected": [6,3,9,2,4,null,12],
      "explanation": "In order the keys read 2, 6, 4, 3, 9, 12; swapping 6 and 3 back makes them increase."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[5,3,8,9,4,7,1]},
      "expected": [5,3,8,1,4,7,9],
      "explanation": "In order the keys read 9, 3, 4, 5, 7, 8, 1: the smallest and largest keys traded places."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[2,3]},
      "expected": [3,2],
      "explanation": "With only two nodes, 3 can't be on the left of 2, so the two keys trade places."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[10,5,15,3,12,7,20]},
      "expected": [10,5,15,3,7,12,20]
    },
    {
      "id": "edge-root-swapped",
      "visible": false,
      "kind": "edge",
      "input": {"root":[3,1,2]},
      "expected": [2,1,3]
    },
    {
      "id": "edge-two-nodes-right",
      "visible": false,
      "kind": "edge",
      "input": {"root":[2,null,1]},
      "expected": [1,null,2]
    },
    {
