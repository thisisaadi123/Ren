{
  "problem": "audio-guide-steps",
  "version": 1,
  "seed": 48883063,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[7,3,15,null,null,9,20],"ops":["next","next","hasNext","next","next","next","hasNext"]},
      "expected": [3,7,1,9,15,20,0],
      "explanation": "The exhibits in order are 3, 7, 9, 15, 20; after the fifth next nothing is left."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[2,1],"ops":["hasNext","next","hasNext","next","hasNext"]},
      "expected": [1,1,1,2,0],
      "explanation": "1 comes before 2, and hasNext turns to 0 after both are visited."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[5],"ops":["hasNext","hasNext"]},
      "expected": [1,1],
      "explanation": "Asking hasNext doesn't move the guide."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"root":[10,5,15,2,7,12,20],"ops":["next","next","next","next","hasNext"]},
      "expected": [2,5,7,10,1]
    },
    {
