  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[-10,-3,0,5,9]},
      "expected": [0,-10,5,null,-3,null,9],
      "explanation": "0 sits in the middle of the list, so it becomes the root. Other balanced search trees are accepted too."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[7]},
      "expected": [7],
      "explanation": "One node is a tree on its own."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"head":[1,2,3]},
      "expected": [2,1,3],
      "explanation": "The middle value 2 is the root."
