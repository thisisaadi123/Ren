{
  "problem": "saved-in-preorder",
  "version": 1,
  "seed": 45443308,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"keys":[8,5,2,6,12,14]},
      "expected": true,
      "explanation": "8 is the root, 5 → 2, 6 is its left side and 12 → 14 its right side."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"keys":[8,5,9,6]},
      "expected": false,
      "explanation": "Once 9 appears we are in 8's right side, so a later 6 is impossible."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"keys":[3,2,1]},
      "expected": true,
      "explanation": "Each key is the left child of the one before it."
