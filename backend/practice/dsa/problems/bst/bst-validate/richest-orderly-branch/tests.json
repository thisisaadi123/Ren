{
  "problem": "richest-orderly-branch",
  "version": 1,
  "seed": 19560597,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[4,1,9,null,null,6,12,5,7]},
      "expected": 44,
      "explanation": "The whole tree is a search tree and its values add up to 44."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[5,3,2,1,4]},
      "expected": 8,
      "explanation": "The whole tree isn't orderly (2 is on the right of 5), but the branch 3 → 1, 4 is, with total 8."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[-3,-8,-1]},
      "expected": -1,
      "explanation": "Every value is negative, so the best orderly branch is the single leaf -1."
    },
