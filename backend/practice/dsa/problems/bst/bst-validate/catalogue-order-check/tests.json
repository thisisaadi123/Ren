      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[10,5,15,null,null,7,20]},
      "expected": false,
      "explanation": "7 sits in the right branch of 10 but is smaller than 10, even though it is fine next to its parent 15."
    },
    {
