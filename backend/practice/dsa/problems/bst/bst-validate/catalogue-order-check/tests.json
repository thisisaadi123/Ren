      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[8,3,12,1,6,null,15]},
      "expected": true,
      "explanation": "Every left branch holds smaller numbers and every right branch larger ones."
    },
