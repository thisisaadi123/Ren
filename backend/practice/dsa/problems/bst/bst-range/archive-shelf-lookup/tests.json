{
  "problem": "archive-shelf-lookup",
  "version": 1,
  "seed": 48324672,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[40,20,60,10,30,50,70],"queries":[[15,55,2],[15,55,5],[0,100,7]]},
      "expected": [30,-1,70],
      "explanation": "Between 15 and 55 the ids are 20, 30, 40, 50: the 2nd is 30 and there is no 5th. All seven ids fit the last band."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[8,3,12],"queries":[[3,3,1],[4,7,1]]},
      "expected": [3,-1],
      "explanation": "The band ends are inclusive, so 3 counts; nothing lies between 4 and 7."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"root":[5,null,9],"queries":[[0,1000000000,2]]},
      "expected": [9],
      "explanation": "The two ids in order are 5 and 9."
    },
    {
