      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"pattern":"3[a2[c]]"},
      "expected": "accaccacc",
      "explanation": "The inner group gives \"acc\", repeated three times."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"pattern":"2[abc]3[cd]ef"},
      "expected": "abcabccdcdcdef",
      "explanation": "Letters outside any group are kept as they are."
