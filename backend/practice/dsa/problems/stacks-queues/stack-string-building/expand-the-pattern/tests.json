    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"pattern":"3[a]2[bc]"},
      "expected": "aaabcbc",
      "explanation": "\"a\" three times, then \"bc\" twice."
    },
