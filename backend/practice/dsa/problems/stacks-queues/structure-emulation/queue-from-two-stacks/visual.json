{
 "walkthrough": {
  "title": "New items go on the inbox stack. The outbox is refilled from the inbox only when it's empty, which reverses the order.",
  "steps": [
   {
    "text": "Two empty stacks.",
    "panels": [
     {
      "type": "row",
      "cells": [],
      "label": "inbox (top on the right)"
     },
     {
      "type": "row",
      "cells": [],
      "label": "outbox (top on the right)"
     }
    ],
    "call": "TwoStackQueue()"
   },
   {
    "text": "Push 1 onto the inbox.",
    "panels": [
     {
      "type": "row",
      "cells": [
       1
      ],
      "states": {
       "0": "new"
      },
      "label": "inbox"
     },
     {
      "type": "row",
      "cells": [],
      "label": "outbox"
     }
    ],
    "call": "push(1)"
   },
   {
    "text": "Push 2 onto the inbox.",
    "panels": [
     {
      "type": "row",
      "cells": [
       1,
       2
      ],
      "states": {
       "1": "new"
      },
      "label": "inbox"
     },
     {
      "type": "row",
      "cells": [],
      "label": "outbox"
     }
    ],
    "call": "push(2)"
   },
   {
    "text": "The outbox was empty, so pour the inbox into it first. The top of the outbox, 1, is the front of the queue.",
    "panels": [
     {
      "type": "row",
      "cells": [],
      "label": "inbox"
     },
     {
      "type": "row",
      "cells": [
       2,
       1
      ],
      "states": {
       "1": "answer"
      },
      "label": "outbox"
     }
    ],
    "call": "peek()",
    "result": "1"
   },
   {
    "text": "Pop 1 off the outbox: it's the oldest item.",
    "panels": [
     {
      "type": "row",
      "cells": [],
      "label": "inbox"
     },
     {
      "type": "row",
      "cells": [
       2
      ],
      "label": "outbox"
     }
    ],
    "call": "pop()",
    "result": "1"
   },
   {
    "text": "Something is still stored.",
    "panels": [
     {
      "type": "row",
      "cells": [],
