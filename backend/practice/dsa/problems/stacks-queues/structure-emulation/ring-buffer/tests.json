{
  "problem": "ring-buffer",
  "version": 1,
  "seed": 52108029,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"calls":[["RingBuffer",3],["enqueue",1],["enqueue",2],["enqueue",3],["enqueue",4],["rear"],["isFull"],["dequeue"],["enqueue",4],["rear"]]},
      "expected": [null,true,true,true,false,3,true,true,true,4],
      "explanation": "The fourth enqueue fails while the buffer is full; after a dequeue there's room again."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"calls":[["RingBuffer",1],["front"],["isEmpty"],["enqueue",7],["front"],["rear"]]},
      "expected": [null,-1,true,true,7,7],
      "explanation": "An empty buffer reports -1; with one item, front and rear are the same."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"calls":[["RingBuffer",2],["dequeue"],["enqueue",5],["dequeue"],["dequeue"]]},
      "expected": [null,false,true,true,false],
      "explanation": "dequeue on an empty buffer returns false."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"calls":[["RingBuffer",2],["enqueue",1],["enqueue",2],["dequeue"],["enqueue",3],["front"],["rear"],["isFull"]]},
      "expected": [null,true,true,true,true,2,3,true]
    },
    {
      "id": "edge-wrap-twice",
      "visible": false,
      "kind": "edge",
      "input": {"calls":[["RingBuffer",2],["enqueue",1],["enqueue",2],["dequeue"],["enqueue",3],["dequeue"],["enqueue",4],["front"],["rear"]]},
      "expected": [null,true,true,true,true,true,true,3,4]
    },
    {
