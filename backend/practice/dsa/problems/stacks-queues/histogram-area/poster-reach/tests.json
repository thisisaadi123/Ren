{
  "problem": "poster-reach",
  "version": 1,
  "seed": 5117077,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"panels":[3,5,4,1,4]},
      "explanation": "Panel 0 (height 3) spreads over 5 and 4 but stops at 1: width 3. Panel 3 (height 1) spreads over the whole fence.",
      "expected": [3,1,2,5,1]
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"panels":[2,2,2]},
      "explanation": "Equal panels never stop a poster, so every poster covers all three.",
      "expected": [3,3,3]
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"panels":[7]},
      "explanation": "One panel, one poster of width 1.",
      "expected": [1]
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"panels":[6,2,5,4,5,1,6]},
      "expected": [1,5,1,3,1,7,1]
    },
    {
      "id": "edge-increasing",
      "visible": false,
      "kind": "edge",
      "input": {"panels":[1,2,3,4,5]},
      "expected": [5,4,3,2,1]
    },
    {
      "id": "edge-decreasing",
      "visible": false,
      "kind": "edge",
      "input": {"panels":[5,4,3,2,1]},
      "expected": [1,2,3,4,5]
    },
    {
      "id": "edge-valley",
      "visible": false,
      "kind": "edge",
      "input": {"panels":[4,3,1,3,4]},
      "expected": [1,2,5,2,1]
    },
    {
      "id": "edge-ties-apart",
      "visible": false,
      "kind": "edge",
      "input": {"panels":[3,1,3,3,1,3]},
      "expected": [1,6,2,2,6,1]
    },
    {
      "id": "edge-big",
      "visible": false,
      "kind": "edge",
      "input": {"panels":[1000000000,1,1000000000,1000000000]},
      "expected": [1,4,2,2]
    },
    {
