{
  "problem": "rewrite-in-postfix",
  "version": 1,
  "seed": 37969903,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"expr":"a+b*c"},
      "explanation": "`*` binds tighter, so `b*c` becomes `bc*` before the `+`.",
      "expected": "abc*+"
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"expr":"(a-b)/c^d^e"},
      "explanation": "The parentheses make `a-b` go first, and `^` groups from the right: `c^(d^e)`.",
      "expected": "ab-cde^^/"
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"expr":"x"},
      "explanation": "A single letter is already in postfix.",
      "expected": "x"
    },
    {
