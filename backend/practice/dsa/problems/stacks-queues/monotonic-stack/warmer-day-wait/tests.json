{
  "problem": "warmer-day-wait",
  "version": 1,
  "seed": 5863513,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"temps":[12,9,10,15,11,16]},
      "explanation": "Day 0 (12°) waits 3 days for 15°. Day 1 (9°) waits 1 day. Day 5 has no warmer day after it.",
      "expected": [3,1,1,2,1,0]
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"temps":[5,5,5]},
      "explanation": "An equally warm day doesn't count, so nobody finds a warmer day.",
      "expected": [0,0,0]
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"temps":[-3,-2,-1]},
      "explanation": "Every day is followed immediately by a warmer one, except the last.",
      "expected": [1,1,0]
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"temps":[30,20,10,25,40]},
      "expected": [4,2,1,1,0]
    },
    {
      "id": "edge-single",
      "visible": false,
      "kind": "edge",
      "input": {"temps":[7]},
      "expected": [0]
    },
    {
      "id": "edge-decreasing",
      "visible": false,
      "kind": "edge",
      "input": {"temps":[9,7,4,0,-2,-100]},
      "expected": [0,0,0,0,0,0]
    },
    {
      "id": "edge-increasing",
      "visible": false,
      "kind": "edge",
      "input": {"temps":[-100,-1,0,1,100]},
      "expected": [1,1,1,1,0]
    },
    {
      "id": "edge-warmer-at-end",
      "visible": false,
      "kind": "edge",
      "input": {"temps":[5,3,4,2,1,6]},
      "expected": [5,1,3,2,1,0]
    },
    {
      "id": "edge-ties-then-warmer",
      "visible": false,
      "kind": "edge",
      "input": {"temps":[4,4,4,5]},
      "expected": [3,2,1,0]
    },
    {
      "id": "edge-extremes",
      "visible": false,
      "kind": "edge",
      "input": {"temps":[100,-100,100,-100]},
      "expected": [0,1,0,0]
    },
    {
      "id": "random",
      "visible": false,
      "kind": "random",
      "generate": {"args":"--n 10","count":6}
    },
