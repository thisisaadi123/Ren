{
  "problem": "next-bigger-on-the-ring",
  "version": 1,
  "seed": 9713164,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"ring":[3,8,4,1,2]},
      "explanation": "Tile 3 (1) sees 2 next. Tile 4 (2) wraps around to 3. Nothing on the ring beats 8.",
      "expected": [8,-1,8,2,3]
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"ring":[6,6,6]},
      "explanation": "Equal numbers are not bigger, so every answer is -1.",
      "expected": [-1,-1,-1]
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"ring":[5,1,2]},
      "explanation": "Tiles 1 and 2 find 2 and 5; 2 finds 5 only by wrapping around.",
      "expected": [-1,2,5]
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"ring":[-7,-9,-3,-9]},
      "expected": [-3,-3,-1,-7]
    },
    {
      "id": "edge-single",
      "visible": false,
      "kind": "edge",
      "input": {"ring":[42]},
      "expected": [-1]
    },
    {
      "id": "edge-two",
      "visible": false,
      "kind": "edge",
      "input": {"ring":[2,1]},
      "expected": [-1,2]
    },
    {
      "id": "edge-decreasing",
      "visible": false,
      "kind": "edge",
      "input": {"ring":[9,7,5,3,1]},
      "expected": [-1,9,9,9,9]
    },
    {
      "id": "edge-increasing",
      "visible": false,
      "kind": "edge",
      "input": {"ring":[1,2,3,4,5]},
      "expected": [2,3,4,5,-1]
    },
    {
      "id": "edge-max-twice",
      "visible": false,
      "kind": "edge",
      "input": {"ring":[4,9,2,9,1]},
      "expected": [9,-1,9,-1,4]
    },
    {
      "id": "edge-extremes",
      "visible": false,
      "kind": "edge",
      "input": {"ring":[1000000000,-1000000000,999999999,-1000000000]},
      "expected": [-1,999999999,1000000000,1000000000]
    },
    {
      "id": "edge-equal-then-bigger",
      "visible": false,
      "kind": "edge",
      "input": {"ring":[3,3,1,3,4]},
      "expected": [4,4,3,4,-1]
    },
