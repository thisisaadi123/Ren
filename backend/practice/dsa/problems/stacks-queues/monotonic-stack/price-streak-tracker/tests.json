{
  "problem": "price-streak-tracker",
  "version": 1,
  "seed": 26754490,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"calls":[["PriceStreak"],["record",40],["record",30],["record",35],["record",32],["record",50]]},
      "explanation": "35 covers itself and 30 (streak 2). 50 is at least every earlier price, so its streak is all 5 days.",
      "expected": [null,1,1,2,1,5]
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"calls":[["PriceStreak"],["record",7],["record",7],["record",7]]},
      "explanation": "An equal price counts, so the streak grows by one each day.",
      "expected": [null,1,2,3]
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"calls":[["PriceStreak"],["record",9],["record",5],["record",1]]},
      "explanation": "Each day is lower than the one before, so every streak is 1.",
      "expected": [null,1,1,1]
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"calls":[["PriceStreak"],["record",3],["record",8],["record",2],["record",2],["record",9],["record",4]]},
      "expected": [null,1,2,1,2,5,1]
    },
