    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"heights":[7,3,5,2,6,4]},
      "explanation": "Person 0 sees 3, 5 and 6: each is taller than everyone between. The 2 is hidden by the 5, and the 4 by the 6.",
      "expected": [3,1,2,1,1,0]
    },
