{
  "problem": "split-around-a-pivot",
  "version": 1,
  "seed": 93401384,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"values":[9,12,5,10,14,3,10],"pivot":10},
      "expected": [9,5,3,10,10,12,14],
      "explanation": "9, 5, 3 are less; the two 10s; then 12, 14."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"values":[-3,4,3,2],"pivot":2},
      "expected": [-3,2,4,3],
      "explanation": "Order inside each group is kept."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"values":[7],"pivot":7},
      "expected": [7],
      "explanation": "One value."
    },
    {
      "id": "edge-all-less",
      "visible": false,
      "kind": "edge",
      "input": {"values":[1,2,3],"pivot":10},
      "expected": [1,2,3]
    },
    {
      "id": "edge-all-greater",
      "visible": false,
      "kind": "edge",
      "input": {"values":[5,4,3],"pivot":-1},
      "expected": [5,4,3]
    },
    {
