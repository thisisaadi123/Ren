  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"slots":[0,3,0,12,5]},
      "expected": [3,12,5,0,0],
      "explanation": "Items keep their order."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"slots":[0]},
      "expected": [0],
      "explanation": "One empty slot."
    },
    {
      "id": "ex3",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"slots":[-1,0,-2]},
      "expected": [-1,-2,0],
      "explanation": "Negative items are still items."
    },
    {
      "id": "edge-no-zeros",
      "visible": false,
      "kind": "edge",
      "input": {"slots":[1,2,3]},
      "expected": [1,2,3]
    },
    {
      "id": "edge-all-zeros",
      "visible": false,
      "kind": "edge",
      "input": {"slots":[0,0,0]},
      "expected": [0,0,0]
    },
