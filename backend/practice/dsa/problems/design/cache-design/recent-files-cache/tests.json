{
  "problem": "recent-files-cache",
  "version": 1,
  "seed": 303,
  "tests": [
    {
      "id": "ex1",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"calls":[["RecentFilesCache",2],["save",1,10],["save",2,20],["open",1],["save",3,30],["open",2],["open",3]]},
      "expected": [null,null,null,10,null,-1,30],
      "explanation": "Opening file 1 makes file 2 the one used longest ago, so saving file 3 into the full cache removes file 2."
    },
    {
      "id": "ex2",
      "visible": true,
      "example": true,
      "kind": "example",
      "input": {"calls":[["RecentFilesCache",1],["save",5,7],["save",5,9],["open",5],["open",4]]},
      "expected": [null,null,null,9,-1],
      "explanation": "Saving file 5 again replaces its size instead of adding a second copy."
    },
    {
      "id": "sample1",
      "visible": true,
      "kind": "sample",
      "input": {"calls":[["RecentFilesCache",3],["open",1],["save",1,1],["save",2,2],["save",3,3],["save",4,4],["open",1],["open",4]]},
      "expected": [null,-1,null,null,null,null,-1,4]
    },
    {
      "id": "edge-capacity-one",
      "kind": "edge",
      "visible": false,
      "input": {"calls":[["RecentFilesCache",1],["save",1,1],["save",2,2],["open",1],["open",2]]},
      "expected": [null,null,null,-1,2]
    },
    {
      "id": "edge-refresh-by-save",
      "kind": "edge",
      "visible": false,
      "input": {"calls":[["RecentFilesCache",2],["save",1,1],["save",2,2],["save",1,5],["save",3,3],["open",2],["open",1]]},
      "expected": [null,null,null,null,null,-1,5]
    },
    {
      "id": "edge-size-zero",
      "kind": "edge",
      "visible": false,
      "input": {"calls":[["RecentFilesCache",2],["save",0,0],["open",0]]},
      "expected": [null,null,0]
    },
    {
      "id": "edge-only-opens",
      "kind": "edge",
      "visible": false,
      "input": {"calls":[["RecentFilesCache",5],["open",1],["open",2]]},
      "expected": [null,-1,-1]
    },
